# ==============================================================================
# CELEBRE CATERING MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Production Domain: https://celebre-eg.com
# Deployment Platform: Vercel Serverless
# ==============================================================================

# 1. PostgreSQL Database URL (Compatible with Neon, Supabase, Vercel Postgres, AWS RDS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/celebre_db?schema=public"

# Direct URL for migrations (Required by connection-pooler providers like Supabase/Neon)
DIRECT_URL="postgresql://postgres:password@localhost:5432/celebre_db?schema=public"

# Vercel Postgres environment variables (auto-populated if using Vercel Postgres)
# POSTGRES_URL="postgres://..."
# POSTGRES_PRISMA_URL="postgres://..."
# POSTGRES_URL_NON_POOLING="postgres://..."

# 2. Node & Server Environment
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://celebre-eg.com"

# 3. Security & Cryptography Secrets (Critical for Vercel Serverless Stateless Sessions)
# Set a strong 32+ character random string for signing admin session tokens (HMAC-SHA256)
SESSION_SECRET="celebre-catering-enterprise-session-v1-production-secret"
AUTH_SECRET="your-32-character-random-auth-secret-key-here"
OTP_SECRET="your-32-character-random-otp-secret-key-here"

# 4. Official WhatsApp Integration
# Standard: Deep Links via official WhatsApp management number (works out of the box, zero configuration)
OFFICIAL_CONTACT_PHONE="01284484868"
OFFICIAL_WHATSAPP_PHONE="01284484868"

# Optional: Meta Cloud WhatsApp Business API (if direct API dispatch without deep links is desired)
# WHATSAPP_API_TOKEN=""
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN="celebre_whatsapp_token_2026"

# 5. Initial Admin User Setup (Used when running `npm run prisma:seed` or `npm run seed`)
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_EMAIL="admin@celebre-eg.com"
ADMIN_INITIAL_PASSWORD=""

# 6. Official Meta Facebook Messenger Integration
# Webhook Callback URL: https://celebre-eg.com/api/messenger/webhook
# Choose a strong secret string for Webhook subscription challenge
MESSENGER_VERIFY_TOKEN="celebre_messenger_verify_token_2026"
# Meta App Secret from developers.facebook.com -> App Settings -> Basic (used for HMAC-SHA256 signature verification)
MESSENGER_APP_SECRET=""
# Page Access Token with pages_messaging permission
MESSENGER_PAGE_ACCESS_TOKEN=""
# Facebook Page ID for Celebre Catering
MESSENGER_PAGE_ID=""


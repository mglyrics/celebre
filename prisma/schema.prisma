// Prisma Schema for Celebre Catering Management System
// Target Database: PostgreSQL (Compatible with Vercel Postgres, Supabase, Neon, Railway)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Roles
enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ACCOUNTANT
  ORDER_MANAGER
  VIEWER
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  displayName String           @map("display_name")
  description String?
  permissions RolePermission[]
  users       AdminUser[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model RolePermission {
  id            String   @id @default(uuid())
  roleId        String   @map("role_id")
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([roleId, permissionKey])
  @@map("role_permissions")
}

// 2. Admin Users
model AdminUser {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  phone        String?
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  isActive     Boolean    @default(true) @map("is_active")
  isLocked     Boolean    @default(false) @map("is_locked")
  lastLoginAt  DateTime?  @map("last_login_at")
  otpCodes     OtpCode[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("admin_users")
}

// 3. OTP Verification Codes
model OtpCode {
  id        String     @id @default(uuid())
  userId    String?    @map("user_id")
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String     @map("code_hash")
  expiresAt DateTime   @map("expires_at")
  attempts  Int        @default(0)
  isUsed    Boolean    @default(false) @map("is_used")
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("otp_codes")
}

// 4. Customers
model Customer {
  id        String            @id @default(uuid())
  fullName  String            @map("full_name")
  phone     String            @unique
  whatsapp  String?
  email     String?
  address   String?
  notes     String?
  orders    Order[]
  payments  CustomerPayment[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([phone])
  @@map("customers")
}

// 5. Menu Items (Sale-01 to Sale-18)
model MenuItem {
  id               String                  @id @default(uuid())
  code             String                  @unique // e.g. "Sale-01"
  name             String
  description      String?
  distributorPrice Decimal                 @map("distributor_price") @db.Decimal(10, 2)
  supplierPrice    Decimal                 @map("supplier_price") @db.Decimal(10, 2)
  isActive         Boolean                 @default(true) @map("is_active")
  sortOrder        Int                     @default(0) @map("sort_order")
  components       MenuItemComponent[]
  priceHistory     MenuPriceHistory[]
  orderItems       OrderItem[]
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@map("menu_items")
}

model MenuItemComponent {
  id            String   @id @default(uuid())
  menuItemId    String   @map("menu_item_id")
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  componentName String   @map("component_name")
  quantity      Decimal  @default(1) @db.Decimal(8, 2)
  unit          String   @default("قطعة")
  sortOrder     Int      @default(0) @map("sort_order")

  @@map("menu_item_components")
}

model MenuPriceHistory {
  id               String    @id @default(uuid())
  menuItemId       String    @map("menu_item_id")
  menuItem         MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  distributorPrice Decimal   @map("distributor_price") @db.Decimal(10, 2)
  supplierPrice    Decimal   @map("supplier_price") @db.Decimal(10, 2)
  validFrom        DateTime  @default(now()) @map("valid_from")
  validTo          DateTime? @map("valid_to")
  createdBy        String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("menu_price_history")
}

// 6. Suppliers / Factory
model Supplier {
  id             String          @id @default(uuid())
  name           String
  companyName    String?         @map("company_name")
  phone          String
  whatsapp       String?
  email          String?
  address        String?
  taxNumber      String?         @map("tax_number")
  notes          String?
  isActive       Boolean         @default(true) @map("is_active")
  supplierOrders SupplierOrder[]
  payments       SupplierPayment[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("suppliers")
}

// 7. Orders
enum OrderStatus {
  PENDING_BOOKING
  CONFIRMED
  SENT_TO_SUPPLIER
  IN_PRODUCTION
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

model Order {
  id                String            @id @default(uuid())
  orderNumber       String            @unique @map("order_number") // CB-YYYYMMDD-XXXX
  customerId        String            @map("customer_id")
  customer          Customer          @relation(fields: [customerId], references: [id])
  orderStatus       OrderStatus       @default(PENDING_BOOKING) @map("order_status")
  pickupDate        DateTime          @map("pickup_date")
  pickupTime        String            @map("pickup_time")
  pickupLocation    String            @map("pickup_location")
  customerNotes     String?           @map("customer_notes")
  cancelReason      String?           @map("cancel_reason")
  
  // Financials - Customer (Celebre Distributor Pricing)
  subtotal          Decimal           @default(0) @db.Decimal(12, 2)
  discount          Decimal           @default(0) @db.Decimal(12, 2)
  adjustments       Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal           @map("total_amount") @db.Decimal(12, 2) // Customer Total
  customerPaid      Decimal           @default(0) @map("customer_paid") @db.Decimal(12, 2)
  customerRemaining Decimal           @map("customer_remaining") @db.Decimal(12, 2)

  // Financials - Factory / Supplier Account (Independent)
  supplierTotal     Decimal           @default(0) @map("supplier_total") @db.Decimal(12, 2)
  supplierPaid      Decimal           @default(0) @map("supplier_paid") @db.Decimal(12, 2)
  supplierRemaining Decimal           @default(0) @map("supplier_remaining") @db.Decimal(12, 2)

  // Distributor Gross Profit (Customer Total - Supplier Total)
  distributorProfit Decimal           @default(0) @map("distributor_profit") @db.Decimal(12, 2)

  items             OrderItem[]
  customerPayments  CustomerPayment[]
  supplierOrders    SupplierOrder[]
  supplierPayments  SupplierPayment[]

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  completedAt       DateTime?         @map("completed_at")
  cancelledAt       DateTime?         @map("cancelled_at")

  @@index([orderNumber])
  @@index([orderStatus])
  @@index([pickupDate])
  @@map("orders")
}

// 8. Order Items with Historical Price Snapshots
model OrderItem {
  id                   String             @id @default(uuid())
  orderId              String             @map("order_id")
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId           String?            @map("menu_item_id")
  menuItem             MenuItem?          @relation(fields: [menuItemId], references: [id])
  menuCode             String             @map("menu_code")
  menuName             String             @map("menu_name")
  quantity             Int

  // Snapshot prices at time of booking
  distributorUnitPrice Decimal            @map("distributor_unit_price") @db.Decimal(10, 2)
  supplierUnitPrice    Decimal            @map("supplier_unit_price") @db.Decimal(10, 2)

  distributorTotal     Decimal            @map("distributor_total") @db.Decimal(12, 2)
  supplierTotal        Decimal            @map("supplier_total") @db.Decimal(12, 2)

  customerAdjustment   Decimal            @default(0) @map("customer_adjustment") @db.Decimal(10, 2) // e.g. -5 (no juice), +10 (pepsi)
  supplierAdjustment   Decimal            @default(0) @map("supplier_adjustment") @db.Decimal(10, 2)

  customerTotal        Decimal            @map("customer_total") @db.Decimal(12, 2)
  supplierTotalFinal   Decimal            @map("supplier_total_final") @db.Decimal(12, 2)
  profit               Decimal            @db.Decimal(12, 2) // customerTotal - supplierTotalFinal

  options              OrderItemOption[]

  @@map("order_items")
}

model OrderItemOption {
  id                    String    @id @default(uuid())
  orderItemId           String    @map("order_item_id")
  orderItem             OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionType            String    @map("option_type") // e.g. "DRINK_EXCLUDE_JUICE", "DRINK_REPLACE_PEPSI"
  optionName            String    @map("option_name")
  distributorAdjustment Decimal   @default(0) @map("distributor_adjustment") @db.Decimal(10, 2)
  supplierAdjustment    Decimal   @default(0) @map("supplier_adjustment") @db.Decimal(10, 2)

  @@map("order_item_options")
}

// 9. Customer Payments (Manual Verification Only - NO Gateway)
enum PaymentMethod {
  INSTAPAY
  CASH
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

model CustomerPayment {
  id               String        @id @default(uuid())
  orderId          String        @map("order_id")
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId       String        @map("customer_id")
  customer         Customer      @relation(fields: [customerId], references: [id])
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @default(INSTAPAY) @map("payment_method")
  paymentStatus    PaymentStatus @default(PENDING_REVIEW) @map("payment_status")
  paymentReference String?       @map("payment_reference")
  notes            String?
  receivedBy       String?       @map("received_by")
  paidAt           DateTime      @default(now()) @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  @@map("customer_payments")
}

// 10. Supplier Orders
enum SupplierOrderStatus {
  PENDING
  ACCEPTED
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

model SupplierOrder {
  id                  String              @id @default(uuid())
  orderId             String              @map("order_id")
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId          String              @map("supplier_id")
  supplier            Supplier            @relation(fields: [supplierId], references: [id])
  supplierOrderNumber String              @unique @map("supplier_order_number")
  supplierTotal       Decimal             @map("supplier_total") @db.Decimal(12, 2)
  supplierPaid        Decimal             @default(0) @map("supplier_paid") @db.Decimal(12, 2)
  supplierRemaining   Decimal             @map("supplier_remaining") @db.Decimal(12, 2)
  status              SupplierOrderStatus @default(PENDING)
  payments            SupplierPayment[]
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@map("supplier_orders")
}

// 11. Supplier Payments (Independent from customer payments)
model SupplierPayment {
  id              String         @id @default(uuid())
  supplierOrderId String         @map("supplier_order_id")
  supplierOrder   SupplierOrder  @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  supplierId      String         @map("supplier_id")
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  orderId         String?        @map("order_id")
  order           Order?         @relation(fields: [orderId], references: [id])
  amount          Decimal        @db.Decimal(12, 2)
  paymentMethod   PaymentMethod  @default(INSTAPAY) @map("payment_method")
  reference       String?
  notes           String?
  paidBy          String?        @map("paid_by")
  paidAt          DateTime       @default(now()) @map("paid_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("supplier_payments")
}

// 12. Security Audit Log
model AuditLog {
  id        String     @id @default(uuid())
  userId    String?    @map("user_id")
  user      AdminUser? @relation(fields: [userId], references: [id])
  username  String?
  action    String
  entity    String
  entityId  String?    @map("entity_id")
  oldData   Json?      @map("old_data")
  newData   Json?      @map("new_data")
  ipAddress String?    @map("ip_address")
  userAgent String?    @map("user_agent")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
